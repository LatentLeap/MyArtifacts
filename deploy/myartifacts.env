# /etc/myartifacts.env — chmod 600. Read by both myartifacts.service and caddy.service.
MYARTIFACTS_DATA=/var/lib/myartifacts
MYARTIFACTS_SHELL_ORIGIN=https://artifacts.latentleap.cc
MYARTIFACTS_USERCONTENT_HOST=usercontent.latentleap.cc
# MYARTIFACTS_WEBHOOK_URL=
# RAM user with AliyunDNSFullAccess, used only by Caddy for the wildcard cert.
ALICLOUD_ACCESS_KEY_ID=
ALICLOUD_ACCESS_KEY_SECRET=
